{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh label *)",
      "Bash(gh repo view *)",
      "Bash(gh api *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-remote *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git merge --ff-only *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge-base *)",
      "Bash(rm plans/*)",
      "Bash(mkdir -p .adw/*)",
      "Bash(tee .adw/*)",
      "Bash(bash .claude/skills/adw/scripts/log.sh case *)",
      "Bash(bash .claude/skills/adw/scripts/tree.sh)",
      "Bash(bash .claude/skills/check/scripts/check.sh)",
      "Bash(bash .claude/skills/check/scripts/check.sh *)",
      "Bash(bash .claude/skills/verify/scripts/red-green.sh *)",
      "Bash(docker info *)",
      "Bash(docker ps *)",
      "Bash(docker compose *)",
      "Bash(docker build *)",
      "Bash(go *)",
      "Bash(GO_ENV=test go *)",
      "Bash(gofmt *)",
      "Bash(soda *)",
      "Bash(playwright-cli *)",
      "Bash(npm ci)",
      "Bash(npx playwright test)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright install *)",
      "Bash(buffalo *)",
      "Bash(which *)",
      "Bash(lsof *)",
      "Bash(pgrep *)",
      "Bash(kill *)",
      "Bash(sleep *)",
      "Bash(curl http://localhost:3000/*)",
      "Bash(curl -s http://localhost:3000/*)",
      "Bash(curl -fsS http://localhost:3000/*)",
      "Bash(curl -sS -i http://localhost:3000/*)",
      "Bash(wget -q --spider http://localhost:3000/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(docker compose down *)",
      "Bash(docker compose down)",
      "Bash(docker volume rm *)",
      "Bash(tee *..*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/adw/scripts/log.sh\" hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/adw/scripts/log.sh\" hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/adw/scripts/log.sh\" hook"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/adw/scripts/log.sh\" hook"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/adw/scripts/log.sh\" hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/adw/scripts/log.sh\" hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/adw/scripts/log.sh\" hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/adw/scripts/log.sh\" hook"
          }
        ]
      }
    ]
  }
}
